+// ============================================================
+// image-mapping.js — association schémas ↔ séances
+// Clé : "unité:index" (index = position du topic dans la liste)
+// ============================================================
+const IMG = {
+  "I:0":   { file: "aliments-familles.png",   legende: "Figure 1 — Les trois familles d'aliments." },
+  "II:3":  { file: "reproduction-animaux.png", legende: "Figure 2 — Les trois modes de reproduction des animaux." },
+  "II:4":  { file: "fleur-pollinisation.png",  legende: "Figure 3 — La fleur et la pollinisation." },
+  "II:5":  { file: "cycle-plante.png",         legende: "Figure 4 — De la graine à la plante : le cycle de vie." },
+  "III:0": { file: "appareil-masculin.png",    legende: "Figure 5 — L'appareil reproducteur masculin." },
+  "III:1": { file: "appareil-feminin.png",     legende: "Figure 6 — L'appareil reproducteur féminin." },
+  "IV:0":  { file: "appareil-urinaire.png",    legende: "Figure 7 — L'appareil urinaire." },
+  "V:3":   { file: "bassin-versant.png",       legende: "Figure 8 — Le bassin versant." },
+  "V:5":   { file: "vases-communicants.png",   legende: "Figure 9 — Les vases communicants." },
+  "V:6":   { file: "distribution-eau.png",     legende: "Figure 10 — La distribution de l'eau dans la ville et les champs." },
+  "VI:1":  { file: "roches-magmatiques.png",   legende: "Figure 11 — Les roches magmatiques." },
+  "VI:2":  { file: "roches-sedimentaires.png", legende: "Figure 12 — Les roches sédimentaires." },
+  "VI:3":  { file: "roches-metamorphiques.png",legende: "Figure 13 — Les roches métamorphiques." },
+  "VI:4":  { file: "roches-classement.png",    legende: "Figure 14 — Comparer les trois groupes de roches." },
+};
+
+function apply(unitNum, topics) {
+  topics.forEach((t, i) => {
+    const key = unitNum + ":" + i;
+    if (IMG[key]) t.image = { ...IMG[key] };
+  });
+  return topics;
+}
+
+module.exports = { IMG, apply };
