+    ]
+
+    t = doc.add_table(rows=2 + len(etapes), cols=6)
+    t.alignment = WD_TABLE_ALIGNMENT.CENTER
+    grille(t)
+    entete_deroulement(t)
+
+    largeurs = [Cm(2.6), Cm(5.2), Cm(4.6), Cm(2.8), Cm(2.4), Cm(1.4)]
