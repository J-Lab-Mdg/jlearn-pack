+        ("Durée", "____________"),
+        ("", ""),
+        ("Valeurs à véhiculer", "autonomie, esprit de créativité"),
+    ]
+    meta_table(doc, gauche, droite)
+    doc.add_paragraph()
+
+    # ------------------------------------------- 2. tableau de deroulement
+    etapes = [
+        ("I. RÉVISION\n____",
+         "Citez trois aliments que vous avez mangés hier.\n"
