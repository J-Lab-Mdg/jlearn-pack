+    retenir.push(...seanceOf(n).lecon.retenir);
+  });
+  return {
+    id: "leconc1_" + num, apres, num,
+    titre, titreS,
+    plage: de === a ? String(de) : `${de} à ${a}`,
+    image: image ? { file: image, w: 1376, h: 768, legende } : null,
+    subs, retenir,
+  };
+}
