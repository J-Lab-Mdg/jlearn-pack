+ children.push(new Paragraph({ children: [new TextRun({ text: "— FIN DU BLOC 3 (SÉANCES 1 À 40) —", font: B.FONT, size: 28, bold: true, color: B.COLORS.rouge })], alignment: AlignmentType.CENTER, spacing: { before: 600 } }));
