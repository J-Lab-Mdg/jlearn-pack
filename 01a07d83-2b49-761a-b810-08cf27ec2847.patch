+  cellp([{ t: "Titre de la séance", b: true }], W[1], { head: true }),
+  cellp([{ t: "Sous-discipline", b: true }], W[2], { head: true }),
+  cellp([{ t: "Durée", b: true }], W[3], { head: true, center: true }),
